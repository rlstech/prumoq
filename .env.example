# ============================================================
# PrumoQ — Environment Variables Template
# Copy to apps/mobile/.env and apps/web/.env.local as needed
# ============================================================

# ── Mobile (apps/mobile/.env) ────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
EXPO_PUBLIC_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
EXPO_PUBLIC_PWA_URL=https://prumoq.example.com

# ── Web Admin (apps/web/.env.local) ──────────────────────────
# Neon Data API (base SEM /rest/v1) e Clerk. Não existe mais service role: operações privilegiadas são funções do banco.
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-xxxx.apirest.c-2.sa-east-1.aws.neon.tech/neondb
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PWA_URL=https://prumoq.example.com
# Só para `pnpm bootstrap:superadmin` (conexão do dono do banco; nunca no ambiente da aplicação):
# DATABASE_URL=postgresql://...
SUPERADMIN_EMAIL=plataforma@example.com
SUPERADMIN_PASSWORD=<minimum-12-character-password>
SUPERADMIN_NAME=Administrador PrumoQ
POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
# OPCIONAL. Hosts extras autorizados a servir imagens no PDF, separados por
# vírgula. O endpoint padrão do R2 (*.r2.cloudflarestorage.com), usado pelas
# URLs assinadas, já é aceito sem configuração. Preencha apenas se as imagens
# vierem de outro host, como um domínio customizado.
# Ex.: fotos.prumoq.com.br
# R2_ALLOWED_MEDIA_HOSTS=

# ── Supabase Edge Functions (set via: supabase secrets set) ──
R2_ACCOUNT_ID=<your-r2-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=prumoq
