# ============================================================
# PrumoQ — Variáveis de ambiente
# Arquivos .env.local só com valores PÚBLICOS (vão para o JavaScript do navegador).
# Segredos ficam nos Workers (`wrangler secret put`) ou na linha de comando, nunca em arquivo.
# ============================================================

# ── PWA (apps/mobile/.env.local) ─────────────────────────────
EXPO_PUBLIC_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
# Data API do Neon (base SEM /rest/v1)
EXPO_PUBLIC_NEON_DATA_API_URL=https://ep-xxxx.apirest.c-2.sa-east-1.aws.neon.tech/neondb
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Rota de mídia do Worker do PWA. Vazio em produção (mesma origem); em dev: http://localhost:8787
EXPO_PUBLIC_MEDIA_API_URL=

# ── Painel admin (apps/admin/.env.local) ─────────────────────
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.c-2.sa-east-1.aws.neon.tech/neondb
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_PWA_URL=https://prumoq.example.com
# Rota de mídia (/api/media/presign do Worker do PWA). Vazio quando PWA e admin estão no mesmo domínio.
VITE_MEDIA_API_URL=

# ── Segredos dos Workers (wrangler secret put <NOME>) ────────
# Worker do PWA (apps/mobile/wrangler.jsonc):
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, NEON_DATA_API_URL
#   ALLOWED_ORIGINS (opcional: origens extras com CORS, separadas por vírgula; ex. o admin em outro domínio)
# Worker do admin (apps/admin/wrangler.jsonc):
#   CLERK_SECRET_KEY, NEON_DATA_API_URL

# ── Só para `pnpm bootstrap:superadmin` (pela linha de comando) ──
# CLERK_SECRET_KEY=sk_test_xxx
# DATABASE_URL=postgresql://...   (dono do banco; nunca no ambiente da aplicação)
# SUPERADMIN_EMAIL=plataforma@example.com
# SUPERADMIN_PASSWORD=<mínimo 12 caracteres>
# SUPERADMIN_NAME=Administrador PrumoQ
