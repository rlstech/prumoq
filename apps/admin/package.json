{
  "name": "@prumoq/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "worker:dev": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@clerk/clerk-react": "5.61.3",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prumoq/design-system": "workspace:*",
    "@prumoq/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.97.0",
    "lucide-react": "^0.475.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.72.1",
    "react-router": "8.5.0",
    "recharts": "^3.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@clerk/backend": "3.26.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "^10.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "8.3.4",
    "wrangler": "4.151.3"
  }
