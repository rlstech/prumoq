// Worker do PWA: arquivos estáticos do `expo export` (dist/) + rota /api/media/presign (worker/index.ts).
// Segredos (R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) vão por `wrangler secret put`, nunca neste arquivo.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "prumoq-pwa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "R2_BUCKET_NAME": "prumoq"
  },
  "observability": { "enabled": true }
}
