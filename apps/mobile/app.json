{
  "expo": {
    "name": "PrumoQ",
    "slug": "prumoq",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "prumoq",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/1518ca00-df13-40d6-96de-29e70691d5ba"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#163B50"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "PrumoQ precisa da câmera para registrar evidências de verificação."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PrumoQ precisa acessar suas fotos para anexar evidências de verificação."
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#163B50"
      },
      "package": "br.com.prumoq.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "br.com.prumoq.app",
      "supportsTablet": true
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "PrumoQ",
      "shortName": "PrumoQ",
      "description": "Gestão da Qualidade para Obras",
      "themeColor": "#163B50",
      "backgroundColor": "#F4F1E8",
      "display": "standalone",
      "orientation": "any",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any maskable"
        },
        {
          "src": "/icon-512.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "any maskable"
        }
      ]
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1518ca00-df13-40d6-96de-29e70691d5ba"
      }
    },
    "owner": "railtonlima"
  }
}
