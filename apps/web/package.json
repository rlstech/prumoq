{
  "name": "@prumoq/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bootstrap:superadmin": "node --env-file=.env.local scripts/bootstrap-superadmin.mjs",
    "preview": "node scripts/build-worker.mjs && opennextjs-cloudflare preview",
    "deploy": "node scripts/build-worker.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:worker": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "6.39.8",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prumoq/design-system": "workspace:*",
    "@prumoq/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.97.0",
    "lucide-react": "^0.475.0",
    "next": "16.4.2",
    "pg": "^8.13.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "zod": "^3.24.0",
    "@opennextjs/cloudflare": "1.20.12",
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.11.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "^10.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "wrangler": "4.151.3"
  }
}
